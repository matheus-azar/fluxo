# Obrigatório na Vercel: PostgreSQL gerenciado (Neon, Supabase ou similar)
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
APP_ENV=production
APP_URL=https://seu-dominio.vercel.app
# SMTP para convites, avisos e recuperação de senha
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Fluxo <contato@seu-dominio.com>
